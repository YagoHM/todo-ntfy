# Copie para ".env" e preencha. Variáveis com prefixo EXPO_PUBLIC_ são embutidas no app.
# Supabase > Project Settings > API (ou botão "Connect")
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "anon" (legada) OU "publishable" (sb_publishable_...). NUNCA use service_role/secret aqui.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Tópico do ntfy: funciona como "senha". Escolha algo longo e impossível de adivinhar.
EXPO_PUBLIC_NTFY_TOPIC=todo-yago-x7k2q9m4
# Opcional (padrão https://ntfy.sh)
EXPO_PUBLIC_NTFY_URL=https://ntfy.sh
